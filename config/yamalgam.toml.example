# yamalgam Configuration (TOML format)
#
# Copy this file to one of the following locations:
#   - .yamalgam.toml (in your project directory)
#   - yamalgam.toml (in your project directory)
#   - ~/.config/yamalgam/config.toml (user-wide config)
#
# Supported formats: TOML, YAML, JSON
# (use the appropriate extension: .toml, .yaml, .yml, .json)
#
# Configuration files are discovered automatically. Project-level configs
# take precedence over user-level configs. The search stops at repository
# boundaries (.git directories).

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

# Minimum log level to display.
# Values: "debug", "info", "warn", "error"
# Default: "info"
# Can be overridden with --verbose (-v) or --quiet (-q) flags.
log_level = "info"

# Log files are written as JSONL with daily rotation.
# Default paths:
# - /var/log/yamalgam.jsonl (Unix, if writable)
# - ~/.local/share/yamalgam/logs/yamalgam.jsonl (fallback)
# Override with environment variables:
# - YAMALGAM_LOG_PATH=/path/to/yamalgam.jsonl  (rotated daily)
# - YAMALGAM_LOG_DIR=/path/to/log/dir
# Optional log directory override:
# log_dir = "/path/to/log/dir"

# ------------------------------------------------------------------------------
# JSON Schema validation
# ------------------------------------------------------------------------------

# Ordered path associations used after document-local schema pragmas and
# top-level $schema properties.
# [[schemas]]
# uri = "./schemas/service.yaml"
# file_match = ["config/*.yaml", "service.yaml"]

# SchemaStore selection and catalog retrieval are disabled by default.
# Network catalogs additionally require `yg validate --allow-refs https`
# and an explicit `--allow-ref-host` entry.
[schema_store]
enabled = false
url = "https://www.schemastore.org/api/json/catalog.json"
